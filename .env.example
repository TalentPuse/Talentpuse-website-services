# Bien moi truong cho docker-compose.yml o thu muc goc.
#
# File nay CHI la mau — khong bao gio dien gia tri that vao day roi commit.
# `.gitignore` da chan `.env*` va chi cho phep `.env.example` di qua.
# Repo nay da tung co mot phat hien ro ri bi mat (JA-04); dung lap lai.
#
# Cac bien khac (DATABASE_URL, JWT_SECRET, OPENAI_API_KEY, ...) duoc mo ta o
# apps/backend/.env.example va apps/frontend/.env.example.

# ── Umami analytics (tu host) ────────────────────────────────────────────────
# Sinh APP_SECRET:      openssl rand -base64 32
# Sinh mat khau DB:     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# UMAMI_APP_SECRET ky cookie phien dang nhap cua Umami. Doi gia tri nay se
# dang xuat toan bo nguoi dung Umami; de trong thi container khong khoi dong.
#
# UMAMI_DB_PASSWORD phai KHOP voi mat khau dat cho role `umami_app` luc cap
# phat database (xem deploy/umami/README.md). Role do chi so huu database
# `umami` va khong co quyen gi tren database cua app.
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
