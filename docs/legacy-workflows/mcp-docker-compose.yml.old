# Pin compose project name (xem chu thich trong apps/backend/docker-compose.yml).
name: talentpulse-mcp

services:
  mcp:
    image: ${MCP_IMAGE:-tp-mcp-local}
    build:
      context: .
      dockerfile: Dockerfile
    container_name: tp-mcp
    ports:
      - "127.0.0.1:8080:8080"
    environment:
      # Doc tu MCP_DATABASE_URL: trong monorepo, ten DATABASE_URL da thuoc ve
      # backend (schema app). MCP tro vao warehouse nen dung secret rieng.
      DATABASE_URL: ${MCP_DATABASE_URL:-postgresql://admin:password@talentpulse-postgres:5432/warehouse}
      DASHBOARD_API_URL: ${DASHBOARD_API_URL:-http://backend:8001}
      DASHBOARD_API_SECRET: ${DASHBOARD_API_SECRET:-}
    networks:
      - talentpulse
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  talentpulse:
    external: true
