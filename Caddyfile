# Caddyfile — reverse proxy with automatic HTTPS
#
# Replace `your-domain.com` below with your actual domain.
# Caddy auto-provisions Let's Encrypt cert on first request.
#
# Routes:
#   /        → Next.js frontend (:3001)
#   /api/*   → FastAPI backend  (:8000)
#   /docs    → FastAPI Swagger UI

your-domain.com {
    encode gzip

    # API routes (FastAPI)
    @api path /api/* /docs /openapi.json
    handle @api {
        reverse_proxy backend:8000
    }

    # Everything else → Next.js
    handle {
        reverse_proxy frontend:3001
    }

    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}

# For local testing without domain — uncomment:
# :80 {
#     @api path /api/* /docs /openapi.json
#     handle @api { reverse_proxy backend:8000 }
#     handle { reverse_proxy frontend:3001 }
# }
