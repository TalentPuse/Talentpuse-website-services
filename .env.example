# TalentPuse Backend — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Database ───────────────────────────────────────────────
# Postgres warehouse (app.* + dbt_dev_gold.* + dbt_dev_silver.* schemas)
DATABASE_URL=postgresql://admin:password@talentpulse-postgres:5432/warehouse

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-prod
CORS_ORIGINS=http://localhost:3001,http://localhost:8002

# ── Telegram alerts ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TalentPuseBot
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

# ── Email alerts (Resend) ──────────────────────────────────
# Get key at https://resend.com/api-keys (restricted "sending only" key is fine).
# Domain below MUST be verified in Resend → https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=TalentPulse <alerts@talentpuse.io.vn>

# ── Alert scheduler ────────────────────────────────────────
# Seconds between alert dispatch slots (default 7200 = 2h)
ALERT_INTERVAL_SECONDS=7200

# ── LLM (OpenAI-compatible) ────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash

# ── S3 / MinIO (CV upload storage) ─────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=
S3_BUCKET_NAME=talentpulse-raw

# ── MCP server (AI assistant tools) ────────────────────────
MCP_SERVER_URL=http://localhost:8080
