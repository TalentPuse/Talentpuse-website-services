# Production environment variables template
# Copy to `.env` and fill in real values.
# NEVER commit `.env` to git (already in .gitignore).

# Postgres admin password
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# MinIO root credentials
MINIO_USER=admin
MINIO_PASSWORD=CHANGE_ME_min_8_chars

# Read-only Postgres user password (must match init-metabase-ro.sql)
METABASE_RO_PASSWORD=metabase_ro

# Public URL for frontend to call backend (Caddy proxies /api)
# Examples:
#   Production: https://your-domain.com
#   Testing:    http://YOUR_VPS_IP
PUBLIC_API_URL=https://your-domain.com
